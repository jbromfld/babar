# Optional explicit administrator environment for `python -m memora.setup`.
# The CLI does not implicitly load this file. Source values yourself when provisioning.
# Never pass these credentials to a runtime MCP child or commit a real .env.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=postgres
PGUSER=replace-with-local-admin
PGPASSWORD=replace-with-local-admin-password

# Runtime alone uses an explicit owner-only JSON file generated by setup:
# MEMORA_CONFIG=/absolute/private/memora-runtime.json
# The profile fixes namespace, dedicated memory credentials, and offline model identity.
# No cloud API keys, tracing configuration, workflow agents, or automatic model downloads.
